---
import BasketProfil from "./BasketProfil.astro";
import BasketDessus from "./BasketDessus.astro";

interface Props {
  configuration?: Record<string, string>;
}

const configuration_defaut = {
  semelle: "#ffffff",
  empeigne: "#ffffff",
  pointe: "#ffffff",
  oeillet: "#ffffff",
  bande: "#ffffff",
  languette: "#ffffff",
  lacet: "#ffffff",
  trimestre: "#ffffff",
};

// Si une configuration a été transmise (après un POST), on l'utilise ; sinon on prend les valeurs par défaut
const { configuration } = Astro.props;
const configuration_basket = configuration ?? configuration_defaut;
---

<div
  class="configurateur"
  data-configuration-defaut={JSON.stringify(configuration_defaut)}
>
  <BasketProfil {...configuration_basket} />
  <BasketDessus {...configuration_basket} />

  <form
    method="POST"
    class="flex flex-wrap items-center justify-center gap-4 py-2"
  >
    {
      Object.entries(configuration_basket).map(([partie, couleur]) => (
        <div class="flex flex-col items-center">
          <label for={partie} class="text-sm capitalize">
            {partie}
          </label>
          <input type="color" id={partie} name={partie} value={couleur} />
        </div>
      ))
    }
    <button type="submit">Valider</button>
    <button type="button" class="reinitialiser">Réinitialiser</button>
  </form>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>(".configurateur")
    .forEach((configurateur) => {
      const configurationDefaut: Record<string, string> = JSON.parse(
        configurateur.dataset.configurationDefaut ?? "{}",
      );

      const inputs = configurateur.querySelectorAll<HTMLInputElement>(
        'input[type="color"]',
      );

      const colorier = (partie: string, couleur: string) => {
        configurateur.querySelectorAll(`svg .${partie}`).forEach((element) => {
          element.setAttribute("fill", couleur);
        });
      };

      inputs.forEach((input) => {
        input.addEventListener("input", () =>
          colorier(input.name, input.value),
        );
      });

      configurateur
        .querySelector(".reinitialiser")
        ?.addEventListener("click", () => {
          inputs.forEach((input) => {
            input.value = configurationDefaut[input.name];
            colorier(input.name, input.value);
          });
        });
    });
</script>
