---
import BasketProfil from "./BasketProfil.astro";
import BasketDessus from "./BasketDessus.astro";

interface Props {
  configuration?: Record<string, string>;
}

const configuration_defaut = {
  semelle: "#ffffff",
  empeigne: "#ffffff",
  pointe: "#ffffff",
  oeillet: "#ffffff",
  bande: "#ffffff",
  languette: "#ffffff",
  lacet: "#ffffff",
  trimestre: "#ffffff",
};

// Si une configuration a été transmise (après un POST), on l'utilise ; sinon on prend les valeurs par défaut
const { configuration } = Astro.props;
const configuration_basket = configuration ?? configuration_defaut;
---

<div
  class="configurateur flex flex-col items-center"
  data-configuration-defaut={JSON.stringify(configuration_defaut)}
>
  <BasketProfil {...configuration_basket} />
  <BasketDessus {...configuration_basket} />

  <form
    method="POST"
    class="flex flex-wrap items-center justify-center gap-4 py-2"
  >
    <label for="description">Nom de la basket :</label>
    <input type="text" id="description" name="description" required />
    {
      Object.entries(configuration_basket).map(([partie, couleur]) => (
        <div class="flex flex-col items-center">
          <label for={partie} class="text-sm capitalize">
            {partie}
          </label>
          <input type="color" id={partie} name={partie} value={couleur} />
        </div>
      ))
    }
    <button type="submit">Valider</button>
    <button type="button" class="reinitialiser">Réinitialiser</button>
  </form>
  <div class="chat-ia flex flex-col items-center gap-2 w-full max-w-md py-4">
    <div
      class="chat-historique flex flex-col gap-2 w-full max-h-60 overflow-y-auto"
    >
    </div>
    <textarea
      class="chat-message textarea textarea-bordered w-full bg-white text-black"
      placeholder="Ex : une semelle noire et des lacets rouge vif"></textarea>
    <button
      type="button"
      class="chat-button px-4 py-2 bg-orange-400 text-white rounded hover:bg-secondary"
    >
      Demander à l'IA
    </button>

    <button type="button" class="nouvelle-conversation">
      Nouvelle conversation
    </button>
  </div>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>(".configurateur")
    .forEach((configurateur) => {
      const configurationDefaut: Record<string, string> = JSON.parse(
        configurateur.dataset.configurationDefaut ?? "{}",
      );

      const inputs = configurateur.querySelectorAll<HTMLInputElement>(
        'input[type="color"]',
      );

      const colorier = (partie: string, couleur: string) => {
        configurateur.querySelectorAll(`svg .${partie}`).forEach((element) => {
          element.setAttribute("fill", couleur);
        });
      };

      inputs.forEach((input) => {
        input.addEventListener("input", () =>
          colorier(input.name, input.value),
        );
      });

      configurateur
        .querySelector(".reinitialiser")
        ?.addEventListener("click", () => {
          inputs.forEach((input) => {
            input.value = configurationDefaut[input.name];
            colorier(input.name, input.value);
          });
        });

      // Chat IA : demande à l'API generateColors une couleur par partie à partir d'une description en langage naturel
      const chatButton =
        configurateur.querySelector<HTMLButtonElement>(".chat-button");
      const chatMessage =
        configurateur.querySelector<HTMLTextAreaElement>(".chat-message");
      const historique: {
        role: "user" | "assistant";
        content: string;
      }[] = [];

      const chatHistorique =
        configurateur.querySelector<HTMLDivElement>(".chat-historique");

      function afficherMessage(role: "user" | "assistant", texte: string) {
        const bulle = document.createElement("div");

        bulle.className = role === "user" ? "chat chat-end" : "chat chat-start";

        const nom = role === "user" ? "Vous" : "IA";
        const heure = new Date().toLocaleTimeString([], {
          hour: "2-digit",
          minute: "2-digit",
        });

        bulle.innerHTML = `
    <div class="chat-image avatar">
      <div class="w-10 rounded-full bg-neutral text-neutral-content flex items-center justify-center">
        <span>${role === "user" ? "V" : "IA"}</span>
      </div>
    </div>

    <div class="chat-header">
      ${nom}
      <time class="text-xs opacity-50">${heure}</time>
    </div>

    <div class="chat-bubble"></div>

    <div class="chat-footer opacity-50">
      ${role === "user" ? "Envoyé" : "Réponse de l’IA"}
    </div>
  `;

        bulle.querySelector(".chat-bubble")!.textContent = texte;

        chatHistorique?.appendChild(bulle);
        chatHistorique?.scrollTo({
          top: chatHistorique.scrollHeight,
          behavior: "smooth",
        });
      }

      chatButton?.addEventListener("click", async () => {
        const message = chatMessage?.value ?? "";
        if (!message) return;

        chatButton.disabled = true;
        chatButton.textContent = "Réflexion en cours...";

        // La configuration actuelle, lue depuis les inputs (pas depuis configurationDefaut) :
        // l'IA doit connaître les couleurs déjà choisies pour ne modifier que ce qu'on lui demande
        const configurationActuelle: Record<string, string> = {};
        inputs.forEach((input) => {
          configurationActuelle[input.name] = input.value;
        });

        try {
          const res = await fetch("/api/generateColours", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              message,
              configuration: configurationActuelle,
              historique,
            }),
          });
          const { couleurs } = await res.json();

          historique.push(
            { role: "user", content: message },
            {
              role: "assistant",
              content: JSON.stringify(couleurs),
            },
          );

          afficherMessage("user", message);
          afficherMessage(
            "assistant",
            `Couleurs appliquées : ${Object.keys(couleurs).join(", ")}`,
          );

          chatMessage.value = "";

          // On applique uniquement les couleurs renvoyées : une partie absente de la réponse garde sa couleur actuelle
          inputs.forEach((input) => {
            if (couleurs[input.name]) {
              input.value = couleurs[input.name];
              colorier(input.name, input.value);
            }
          });
        } finally {
          // finally, et pas juste après le fetch : le bouton doit se réactiver même si la requête échoue (réseau, erreur serveur...)
          chatButton.disabled = false;
          chatButton.textContent = "Demander à l'IA";
        }
      });
    });
</script>
