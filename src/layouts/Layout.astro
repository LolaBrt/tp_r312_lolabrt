---
import "../styles/global.css";
import "@fontsource-variable/manrope/wght.css";
import "@fontsource/erica-one";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import db from "../lib/db.js";

interface Props {
  title?: string;
  description?: string;
  locale?: "fr" | "en";
}

const { title, description, locale = "fr" } = Astro.props;
const savedTheme = Astro.locals.user
  ? db
      .query("SELECT theme FROM USER_PREFERENCES WHERE user_id = ?")
      .get(Astro.locals.user.id)?.theme
  : undefined;
const initialTheme = savedTheme === "dark" ? "dark" : "light";
const siteName = "Tp1_DevFront_LolaBrouart_A2";
const titleHead =
  Astro.url.pathname === "/" ? siteName : `${title} — ${siteName}`;
---

<!doctype html>
<html lang={locale} data-initial-theme={initialTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      href="/public/realFavIcon/favicon-96x96.png"
      sizes="96x96"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/public/realFavIcon/favicon.svg"
    />
    <link rel="shortcut icon" href="/public/realFavIcon/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/public/realFavIcon/apple-touch-icon.png"
    />
    <meta name="apple-mobile-web-app-title" content="MyWebSite" />
    <link rel="manifest" href="/public/realFavIcon/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{titleHead}</title>
    <meta name="description" content={description} />
    <script is:inline>
      const initialTheme =
        document.documentElement.dataset.initialTheme === "dark"
          ? "dark"
          : localStorage.getItem("theme") === "dark"
            ? "dark"
            : "light";
      const theme = initialTheme;
      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body>
    <Header locale={locale} />
    <main class="py-30 px-40">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
